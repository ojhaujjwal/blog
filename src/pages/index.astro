---
import { SITE } from "@config";
import Layout from "@layouts/Layout.astro";
import Footer from "@components/Footer.astro";
import Socials from "@components/Socials.astro";
import ExperienceEntry from "@components/ExperienceEntry.astro";
---

<Layout title={`${SITE.title} — Senior Software Engineer`}>

  <main id="main-content" class="mx-auto max-w-3xl px-4 pb-16 pt-8">
    <!-- Hero -->
    <section class="mb-14">
      <h1 class="text-3xl font-bold sm:text-4xl text-skin-accent">{SITE.author}</h1>
      <p class="mt-1 text-lg text-skin-base/80">Senior Software Engineer</p>
      <p class="mt-4 max-w-xl leading-relaxed">
        I am a Senior Software Engineer who unblocks business bottlenecks and uplifts engineering standards by designing heavy-typed, contract-tested systems rooted in Domain-Driven Design and event-driven architectures.
      </p>
      <div class="mt-4">
        <Socials />
      </div>
    </section>

    <!-- Experience -->
    <section class="mb-14">
      <h2 class="mb-6 text-xl font-semibold tracking-wide">Experience</h2>
      <div class="space-y-8">

        <ExperienceEntry
          role="Senior Software Engineer"
          company="Ubank"
          location="Sydney"
          period="APR 2025 — Present"
          highlights={[
            "Set the technical strategy for type safety and contract testing — designed an incremental strict-null-checks rollout and enforced runtime response validation so services comply with their OpenAPI specs and clients can trust generated contracts.",
            "Championed the migration from store-managed API state to TanStack Query — authored the RFC and designed a backporting mechanism that keeps the legacy store in sync while new features migrate incrementally, proven on accounts, the most legacy-heavy part of the banking app.",
            "Raised the bar on production reliability and security as a product engineer — built a startup config gate that blocks misconfigured pods from being promoted, so missing or invalid config fails at deploy time instead of at runtime, and stopped secrets from leaking into logs at the source.",
          ]}
        />

        <ExperienceEntry
          role="Senior Software Engineer"
          company="Maytes"
          location="North Sydney"
          period="APR 2024 — APR 2025"
          highlights={[
            "Made a broken foundation production-safe — inherited an API where every endpoint returned HTTP 200 with `status: false` in the body and a failing test suite; established a JSON API error standard with string error codes, and revived the tests end-to-end until green on CI.",
            "Made the API contract enforceable — authored the OpenAPI spec, built a v2 middleware validating requests and responses against it, generated the core banking provider's SDK from the spec, and stood up a mock provider so every banking gateway could be contract-tested.",
            "Rebuilt the platform around modules and events — modular, hexagonal services with explicit ports, a banking-gateway abstraction, and EventBridge pub-sub with DLQs; defended the event-driven direction under pressure rather than falling back to synchronous dispatchers.",
            "Delivered the flagship product on the new foundation — led the breakdown, sequencing, and delivery of expense splitting, a new kind of offering, released on top of the contract-driven platform.",
          ]}
        />

        <ExperienceEntry
          role="Team Lead"
          company="Shippit"
          location="Sydney"
          period="AUG 2023 — FEB 2024"
          highlights={[
            "Led the team in discovery and delivery on multiple iterations of a complex, one-of-a-kind logistics optimisation tool which required a deep understanding of logic frameworks and customer needs.",
            "Collaborated with Design and Product to investigate integration solutions and provide recommendations to improve our reporting functionality.",
            "Mentored fellow engineers and conducted code reviews to ensure software quality.",
          ]}
        />

        <ExperienceEntry
          role="Senior Software Engineer"
          company="Shippit"
          location="Sydney"
          period="SEP 2021 — AUG 2023"
          highlights={[
            "Led feature implementation in backend (Node, TypeScript) and in frontend (React).",
            "Implemented advanced monitoring and observability capabilities using DataDog to improve tech resilience.",
            "Upgraded a critical Aurora Postgres database on prod with close to zero downtime.",
            "Setup technical infra for multiple services on AWS with a proven track of handling millions of orders in a day.",
          ]}
        />

        <ExperienceEntry
          role="Software Engineer"
          company="The Iconic"
          location="Sydney"
          period="APR 2019 — SEP 2021"
          highlights={[
            "Migrated integration of multiple third party systems smoothly, resulting in zero downtime for our user base.",
            "Introduced Domain Driven Design and CQRS to architecture a new PHP-based microservice.",
            "Contributed to troubleshooting and resolving website outages and prepared subsequent incident reports.",
            "Automated end-to-end CI build and deployment for new services using Kubernetes and Terraform on AWS.",
            "Re-engineered PHP/JS microservices to handle increased traffic.",
          ]}
        />

        <ExperienceEntry
          role="Software Engineer"
          company="Logpoint"
          period="OCT 2017 — MAR 2019"
        />

        <ExperienceEntry
          role="Software Engineer"
          company="Introcept Nepal"
          period="AUG 2016 — SEP 2017"
        />

        <ExperienceEntry
          role="Software Engineer (Contracting)"
          company="Yiwii LLC"
          period="AUG 2015 — AUG 2016"
        />

        <ExperienceEntry
          role="Software Developer"
          company="Hrevert Technologies"
          period="MAY 2013 — AUG 2015"
        />

      </div>
    </section>

    <!-- Skills -->
    <section class="mb-14">
      <h2 class="mb-4 text-xl font-semibold tracking-wide">Skills</h2>
      <div class="space-y-3">
        <div>
          <span class="text-sm font-medium text-skin-accent">Languages:</span>
          <div class="mt-1 flex flex-wrap gap-2">
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">TypeScript / JavaScript</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">Node.js</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">React</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">PHP</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">Ruby</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">Python</span>
          </div>
        </div>
        <div>
          <span class="text-sm font-medium text-skin-accent">Ops &amp; Infrastructure:</span>
          <div class="mt-1 flex flex-wrap gap-2">
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">Docker</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">DevOps</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">SRE</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">Terraform</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">Kubernetes</span>
            <span class="rounded bg-skin-card px-2.5 py-1 text-xs">GCP</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section class="mb-14">
      <h2 class="mb-4 text-xl font-semibold tracking-wide">Education</h2>
      <div>
        <p class="font-medium">Bachelor of Science in Computer Science and Information Technology</p>
        <p class="text-sm text-skin-base/60">Tribhuvan University, Kathmandu</p>
      </div>
    </section>

    <!-- Blog CTA -->
    <section class="border-t border-dashed pt-8">
      <p class="text-center">
        <a href="/blog/" class="text-lg underline decoration-dashed underline-offset-4 hover:text-skin-accent"
          >Read my blog &rarr;</a
        >
      </p>
    </section>
  </main>

  <Footer noMarginTop />
</Layout>

<style>
  #main-content {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
</style>
