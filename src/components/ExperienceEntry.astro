---
interface Props {
  role: string;
  company: string;
  location?: string;
  period: string;
  highlights?: string[];
  collapsible?: boolean;
}
const { role, company, location, period, highlights = [], collapsible = false } = Astro.props;
---

{
  collapsible ? (
    <>
      <details class="group print-hide">
        <summary class="flex cursor-pointer list-none items-center justify-between">
          <span class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between sm:gap-2">
            <h3 class="font-medium">
              {role} — <span class="text-skin-accent">{company}</span>
              {location && <span>, {location}</span>}
            </h3>
            <span class="text-sm text-skin-base/60">{period}</span>
          </span>
          <span class="ml-2 shrink-0 text-skin-base/60 transition-transform group-open:rotate-90">▸</span>
        </summary>
        {
          highlights.length > 0 && (
            <ul class="mt-2 list-disc pl-5 space-y-1 text-sm leading-relaxed">
              {highlights.map(highlight => <li>{highlight}</li>)}
            </ul>
          )
        }
      </details>

      {/* Print-only: expanded, no toggle */}
      <div class="print-only">
        <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
          <h3 class="font-medium">
            {role} — <span class="text-skin-accent">{company}</span>
            {location && <span>, {location}</span>}
          </h3>
          <span class="text-sm text-skin-base/60">{period}</span>
        </div>
        {
          highlights.length > 0 && (
            <ul class="mt-2 list-disc pl-5 space-y-1 text-sm leading-relaxed">
              {highlights.map(highlight => <li>{highlight}</li>)}
            </ul>
          )
        }
      </div>
    </>
  ) : (
    <div>
      <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
        <h3 class="font-medium">
          {role} — <span class="text-skin-accent">{company}</span>
          {location && <span>, {location}</span>}
        </h3>
        <span class="text-sm text-skin-base/60">{period}</span>
      </div>
      {
        highlights.length > 0 && (
          <ul class="mt-2 list-disc pl-5 space-y-1 text-sm leading-relaxed">
            {highlights.map(highlight => <li>{highlight}</li>)}
          </ul>
        )
      }
    </div>
  )
}
