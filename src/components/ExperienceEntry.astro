---
interface Props {
  role: string;
  company: string;
  location?: string;
  period: string;
  highlights?: string[];
}
const { role, company, location, period, highlights = [] } = Astro.props;
---

<div>
  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between">
    <h3 class="font-medium">
      {role} — <span class="text-skin-accent">{company}</span>
      {location && <span>, {location}</span>}
    </h3>
    <span class="text-sm text-skin-base/60">{period}</span>
  </div>
  {
    highlights.length > 0 && (
      <ul class="mt-2 list-disc pl-5 space-y-1 text-sm leading-relaxed">
        {highlights.map(highlight => <li>{highlight}</li>)}
      </ul>
    )
  }
</div>
